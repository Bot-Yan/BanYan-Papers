# tree2 站点运行时配置样例
# 真实值只放服务器：/etc/treenext.env（权限 600，由 tree2.service 的
# EnvironmentFile= 注入），不进仓库。本地开发不配置也能跑，对应功能自动隐藏。

# 网站页脚展示的 ICP 备案号；留空则不显示备案链接
TREE2_ICP=

# WebDAV 各角色的 Basic 用户名（可选；不配则用户名随意、口令决定角色）。
# 配了之后客户端必须用这个用户名 + 对应口令；Bearer 口令不受影响。
TREE2_ADMIN_USER=
TREE2_WEBDAV_USER=
TREE2_CUSTOMER_USER=
TREE2_VISITOR_USER=
